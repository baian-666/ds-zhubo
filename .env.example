# Store real values in Codespaces secrets or an ignored .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=8787
# Required (24+ characters) before binding to a non-loopback address.
COHOST_ACCESS_TOKEN=

# Optional cloud speech service. Keep the real key only in ignored .env.
SILICONFLOW_API_KEY=

# Bilibili Live Open Platform. Read docs/BILIBILI.md. Never put real values in this file.
BILIBILI_ACCESS_KEY_ID=
BILIBILI_ACCESS_KEY_SECRET=
BILIBILI_APP_ID=
BILIBILI_ANCHOR_CODE=
# Optional local blivechat receiver (no own developer application required).
# BILIBILI_SOURCE=blivechat
# BILIBILI_RELAY_URL=ws://127.0.0.1:12451/api/chat
# BILIBILI_RELAY_ROOM_ID= (only when not using an anchor code)
